rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global fallback: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper to check if a user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check if user has admin custom claim or system admin credentials
    function isPlatformAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin'
      );
    }

    // ID Validation Guard (prevents large string payload poisoning and ID injection)
    function isValidId(id) {
      return id is string && id.size() < 128 && !id.matches(".*[\\s\\x00-\\x1F\\x7F].*");
    }

    // Allowed keys gate (prevents extra/malicious fields injection and size bloat)
    function affectedKeys(allowedList) {
      return request.resource.data.keys().hasOnly(allowedList);
    }

    // Workspace Access Helper - ensures users can only read/write data in workspaces they own, admin, or are members of
    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && (isPlatformAdmin() || 
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.uid == request.auth.uid ||
        (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.admins != null && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.admins[request.auth.uid] == true) ||
        (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.roles != null && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.roles[request.auth.uid] != null)
      );
    }

    // Workspace Role Resolution Helpers
    function workspaceRole(wsId) {
      let wsData = get(/databases/$(database)/documents/workspaces/$(wsId)).data;
      return wsData.uid == request.auth.uid ? 'owner' : (
        wsData.roles != null && wsData.roles[request.auth.uid] != null
          ? wsData.roles[request.auth.uid]
          : (wsData.admins != null && wsData.admins[request.auth.uid] == true ? 'owner' : 'viewer')
      );
    }

    function canWrite(wsId) {
      return isSignedIn() && (isPlatformAdmin() || workspaceRole(wsId) in ['owner', 'accountant', 'bookkeeper']);
    }

    function canAdmin(wsId) {
      return isSignedIn() && (isPlatformAdmin() || workspaceRole(wsId) in ['owner', 'accountant']);
    }

    // Immutability Guard - ensures immutable variables cannot be altered
    function isUnchanged(field) {
      return resource == null ||
        request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    match /apiKeys/{keyId} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false; // Managed via server-side API
    }

    // Users collection rules with privilege escalation and email overwrite protection
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) &&
        affectedKeys(["uid", "email", "role", "createdAt", "updatedAt", "customLimit", "computeCreditLimit"]) &&
        (request.resource.data.role == "client" || (request.resource.data.role == "admin" && isPlatformAdmin())) &&
        request.resource.data.email == request.auth.token.get('email', '');
      allow update: if isSignedIn() && request.auth.uid == userId && 
        isUnchanged("role") && 
        isUnchanged("email") &&
        affectedKeys(["uid", "email", "role", "createdAt", "updatedAt", "customLimit", "computeCreditLimit"]);
      allow delete: if false;
    }

    // Workspaces collection rules
    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() && (isPlatformAdmin() || resource == null || resource.data.uid == request.auth.uid || (resource.data.admins != null && resource.data.admins[request.auth.uid] == true) || isWorkspaceMember(workspaceId));
      allow list: if isSignedIn() && (isPlatformAdmin() || resource.data.uid == request.auth.uid || (resource.data.admins != null && resource.data.admins[request.auth.uid] == true) || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid && isValidId(workspaceId) &&
        request.resource.data.name.size() < 128 &&
        (!("description" in request.resource.data) || request.resource.data.description.size() < 1000) &&
        (!("plan" in request.resource.data) || request.resource.data.plan == "starter" || request.resource.data.plan == "free") &&
        (!("computeCreditBalance" in request.resource.data) || request.resource.data.computeCreditBalance <= 100) &&
        (!("bypassBilling" in request.resource.data) || request.resource.data.bypassBilling == false) &&
        (!("maxSeats" in request.resource.data) || request.resource.data.maxSeats <= 5) &&
        affectedKeys(["id", "uid", "name", "businessType", "type", "description", "createdAt", "updatedAt", "lockDate", "currency", "matchingThreshold", "isDemoLoaded", "plan", "billingCycle", "concurrentUserLimit", "activeUserCount", "maxSeats", "billingLedgerChain", "apiQuotaTotalCentsUsed", "apiQuotaMonthlyLimitCents", "computeCreditBalance", "strategicAdvice", "lockedUntilDate", "seatCount", "stripeCustomerId", "stripeSubscriptionId", "status", "adminCount", "admins", "roles", "dateFormat", "aiModel", "notifications", "analyticalTopology", "totalQueriesThisMonth", "computeHardnessScore", "defaultAccountMappings", "dimensions", "allowedWorldPaths", "bypassBilling", "members"]);
      allow update: if isSignedIn() && (
        isPlatformAdmin() ||
        (
          (resource.data.uid == request.auth.uid || canAdmin(workspaceId)) &&
          isUnchanged("uid") &&
          isUnchanged("plan") && isUnchanged("computeCreditBalance") && isUnchanged("apiQuotaMonthlyLimitCents") && isUnchanged("maxSeats") && isUnchanged("concurrentUserLimit") &&
          isUnchanged("apiQuotaTotalCentsUsed") && isUnchanged("stripeCustomerId") && isUnchanged("seatCount") &&
          isUnchanged("status") && isUnchanged("lockedUntilDate") &&
          isUnchanged("bypassBilling") && isUnchanged("stripeSubscriptionId")
        )
      ) &&
      (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["lockDate"]) || canAdmin(workspaceId)) &&
      affectedKeys(["id", "uid", "name", "businessType", "type", "description", "createdAt", "updatedAt", "lockDate", "currency", "matchingThreshold", "isDemoLoaded", "plan", "billingCycle", "concurrentUserLimit", "activeUserCount", "maxSeats", "billingLedgerChain", "apiQuotaTotalCentsUsed", "apiQuotaMonthlyLimitCents", "computeCreditBalance", "strategicAdvice", "lockedUntilDate", "seatCount", "stripeCustomerId", "stripeSubscriptionId", "status", "adminCount", "admins", "roles", "dateFormat", "aiModel", "notifications", "analyticalTopology", "totalQueriesThisMonth", "computeHardnessScore", "defaultAccountMappings", "dimensions", "allowedWorldPaths", "bypassBilling", "members"]);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Presence collection rules for multi-user collaboration
    match /presence/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (resource != null && resource.data.currentWorkspaceId != null && isWorkspaceMember(resource.data.currentWorkspaceId))
      );
      allow write: if isSignedIn() && request.auth.uid == userId && isValidId(userId) &&
        affectedKeys(["uid", "email", "displayName", "photoURL", "lastActive", "activeTab", "state", "currentWorkspaceId"]);
    }

    // Helper to check if a transaction date is on or before the workspace's lockDate
    function isTransactionPeriodOpen(workspaceId, txDate) {
      let wsData = get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
      return wsData.lockDate == null || wsData.lockDate == "" || txDate > wsData.lockDate;
    }

    // Specific rules for all tenant-scoped ledger resources to eliminate the general pattern loophole
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if canWrite(request.resource.data.workspaceId) && isValidId(transactionId) && isTransactionPeriodOpen(request.resource.data.workspaceId, request.resource.data.date);
      allow update: if canWrite(resource.data.workspaceId) && isUnchanged("workspaceId") && isTransactionPeriodOpen(resource.data.workspaceId, resource.data.date);
      allow delete: if canWrite(resource.data.workspaceId);
    }

    match /chartAccounts/{accountId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canAdmin(request.resource.data.workspaceId) && isValidId(accountId) &&
        affectedKeys(["id", "uid", "workspaceId", "name", "code", "type", "category", "subtype", "taxCategory", "description", "currency", "balanceCents", "openingBalanceCents", "asOfDate", "parentId", "projectAllocations", "isContra", "isArchived", "archived", "isActive", "createdAt", "updatedAt", "isSystem", "classification"]);
      allow update: if isSignedIn() && canAdmin(resource.data.workspaceId) && isUnchanged("workspaceId") && isUnchanged("uid") &&
        isUnchanged("balanceCents") && isUnchanged("openingBalanceCents") && isUnchanged("isSystem") &&
        (resource.data.isSystem != true || (isUnchanged("type") && isUnchanged("code") && isUnchanged("classification"))) &&
        affectedKeys(["id", "uid", "workspaceId", "name", "code", "type", "category", "subtype", "taxCategory", "description", "currency", "balanceCents", "openingBalanceCents", "asOfDate", "parentId", "projectAllocations", "isContra", "isArchived", "archived", "isActive", "createdAt", "updatedAt", "isSystem", "classification"]);
      allow delete: if isSignedIn() && canAdmin(resource.data.workspaceId) && (resource.data.isSystem == null || resource.data.isSystem == false);
    }

    match /projects/{projectId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(projectId) &&
        affectedKeys(["id", "uid", "workspaceId", "name", "description", "type", "status", "pipelineStage", "budgetCents", "costCodes", "laborBuckets", "materialsBuckets", "subcontractCosts", "dimensions", "tags", "splitRules", "metadata", "createdAt", "updatedAt"]);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId") &&
        affectedKeys(["id", "uid", "workspaceId", "name", "description", "type", "status", "pipelineStage", "budgetCents", "costCodes", "laborBuckets", "materialsBuckets", "subcontractCosts", "dimensions", "tags", "splitRules", "metadata", "createdAt", "updatedAt"]);
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /invites/{inviteId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create, update, delete: if false; // Managed via server-side API only
    }

    match /auditLogs/{logId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && (request.resource.data.uid == request.auth.uid || request.resource.data.userId == request.auth.uid) && isWorkspaceMember(request.resource.data.workspaceId) && isValidId(logId) &&
        affectedKeys(["id", "uid", "userId", "workspaceId", "action", "details", "severity", "userEmail", "email", "actorUid", "actorEmail", "documentId", "entityId", "collectionName", "entityType", "metadata", "timestamp"]);
      allow update, delete: if false; // Forensically immutable audit trail
    }

    match /journalEntries/{entryId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create, update, delete: if false; // Server-side append-only
    }

    match /bankLines/{lineId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create, update, delete: if false; // Server-side managed
    }

    match /billingLedgerTraces/{traceId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create, update, delete: if false; // Server-side trace generation only
    }

    match /deepAuditJobs/{jobId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create, update, delete: if false; // Server-side job execution only
    }

    match /stripeProcessedEvents/{eventId} {
      allow read, write: if false; // Internal server-side idempotency lock only
    }

    match /idempotencyKeys/{keyId} {
      allow read, write: if false; // Internal server-side idempotency cache only
    }

    match /admins/{docId} {
      allow read: if isPlatformAdmin();
      allow write: if false; // Server-side admin SDK only
    }

    match /external_api_cache/{cacheKey} {
      allow read, write: if false; // Internal server-side cache only
    }

    match /reconciliations/{recId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(recId);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId");
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(invoiceId);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId");
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(paymentId);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId");
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /estimates/{estimateId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(estimateId);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId");
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /bills/{billId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(billId);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId");
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /inventory/{itemId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(itemId);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId");
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /recurring/{ruleId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(ruleId);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId");
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /budgets/{budgetId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(budgetId);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId");
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /autoRules/{ruleId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(ruleId);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId");
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /fixedAssets/{assetId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(assetId);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId");
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /assets/{assetId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(assetId);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId");
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /taxRates/{rateId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(rateId);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId");
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /dimensionNodes/{nodeId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(nodeId);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId");
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /workspaceShards/{shardId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(shardId);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId");
      allow delete: if false;
    }

    match /vendors/{vendorId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(vendorId);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId");
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /creditNotes/{creditNoteId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(creditNoteId) &&
        affectedKeys(["id", "uid", "workspaceId", "customerId", "customerName", "number", "invoiceId", "amountCents", "remainingCents", "date", "reason", "status", "currency", "createdAt", "updatedAt"]);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId") &&
        affectedKeys(["id", "uid", "workspaceId", "customerId", "customerName", "number", "invoiceId", "amountCents", "remainingCents", "date", "reason", "status", "currency", "createdAt", "updatedAt"]);
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /vendorCredits/{vendorCreditId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(vendorCreditId) &&
        affectedKeys(["id", "uid", "workspaceId", "vendorId", "vendorName", "number", "billId", "amountCents", "remainingCents", "date", "reason", "status", "currency", "createdAt", "updatedAt"]);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId") &&
        affectedKeys(["id", "uid", "workspaceId", "vendorId", "vendorName", "number", "billId", "amountCents", "remainingCents", "date", "reason", "status", "currency", "createdAt", "updatedAt"]);
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /employees/{employeeId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(employeeId);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId");
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /payRuns/{runId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(runId);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId");
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /partners/{partnerId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && canWrite(request.resource.data.workspaceId) && isValidId(partnerId);
      allow update: if isSignedIn() && canWrite(resource.data.workspaceId) && isUnchanged("workspaceId");
      allow delete: if isSignedIn() && canWrite(resource.data.workspaceId);
    }

    match /learnedDeltas/{deltaId} {
      allow read: if isSignedIn() && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid && isWorkspaceMember(request.resource.data.workspaceId) && isValidId(deltaId) &&
        request.resource.data.description is string && request.resource.data.description.size() <= 500 &&
        request.resource.data.category is string && request.resource.data.category.size() <= 100 &&
        affectedKeys(["id", "uid", "workspaceId", "apiKeyId", "description", "category", "timestamp"]);
      allow update: if isSignedIn() && request.resource.data.uid == request.auth.uid && isWorkspaceMember(request.resource.data.workspaceId) && isUnchanged("workspaceId") && isUnchanged("uid") &&
        request.resource.data.description is string && request.resource.data.description.size() <= 500 &&
        request.resource.data.category is string && request.resource.data.category.size() <= 100 &&
        affectedKeys(["id", "uid", "workspaceId", "apiKeyId", "description", "category", "timestamp"]);
      allow delete: if false; // Only allow organic machine learning append, no history rewrite
    }

    match /customTemplates/{templateId} {
      allow read: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid && isValidId(templateId) &&
        affectedKeys(["name", "industry", "accounts", "analyticalTopology", "uid", "createdAt"]);
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid && isUnchanged("uid") &&
        affectedKeys(["name", "industry", "accounts", "analyticalTopology", "uid", "createdAt"]);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    function isProtectedCollection(name) {
      return name in ["users", "workspaces", "apiKeys", "presence", "transactions", "chartAccounts", "projects", "auditLogs", "learnedDeltas", "customTemplates", "journalEntries", "idempotencyKeys", "bankLines", "billingLedgerTraces", "deepAuditJobs", "stripeProcessedEvents", "admins", "external_api_cache", "reconciliations", "supportTickets", "supportMessages", "invoices", "bills", "inventory", "recurring", "budgets", "autoRules", "fixedAssets", "assets", "taxRates", "vendors", "customers", "employees", "payRuns", "partners", "errorLogs", "dimensionNodes", "workspaceShards", "invites", "creditNotes", "vendorCredits"];
    }

    match /supportTickets/{ticketId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        resource.data.uid == request.auth.uid ||
        isWorkspaceMember(resource.data.workspaceId)
      );
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && (isPlatformAdmin() || isWorkspaceMember(request.resource.data.workspaceId))
        && isValidId(ticketId)
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 200
        && request.resource.data.status == 'open'
        && affectedKeys(['id', 'workspaceId', 'uid', 'subject', 'status', 'priority', 'createdAt', 'updatedAt', 'lastMessageAt', 'lastMessageBy', 'unreadForUser', 'unreadForAdmin', 'errorLogId', 'errorDiagnostics']);
      allow update: if isSignedIn() && (
        isPlatformAdmin() ||
        (isWorkspaceMember(resource.data.workspaceId)
          && isUnchanged("workspaceId") && isUnchanged("uid")
          && isUnchanged("createdAt")
          // Users can only close/resolve or update unread flags/metadata during normal flow
          && (request.resource.data.status == 'closed' || request.resource.data.status == 'resolved' || request.resource.data.status == resource.data.status)
        )
      ) && affectedKeys(['id', 'workspaceId', 'uid', 'subject', 'status', 'priority', 'createdAt', 'updatedAt', 'lastMessageAt', 'lastMessageBy', 'unreadForUser', 'unreadForAdmin', 'errorLogId', 'errorDiagnostics']);
      allow delete: if false;
    }

    match /errorLogs/{logId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        (resource != null && (resource.data.userId == request.auth.uid || isWorkspaceMember(resource.data.workspaceId)))
      );
      allow create: if isSignedIn()
        && (isPlatformAdmin() || isWorkspaceMember(request.resource.data.workspaceId) || request.resource.data.userId == request.auth.uid)
        && isValidId(logId)
        && request.resource.data.message is string && request.resource.data.message.size() <= 4000
        && affectedKeys(['id', 'workspaceId', 'userId', 'userEmail', 'message', 'stack', 'componentStack', 'url', 'userAgent', 'appVersion', 'release', 'source', 'severity', 'metadata', 'ticketId', 'createdAt']);
      allow update, delete: if false; // Immutable forensic error telemetry
    }

    match /supportMessages/{messageId} {
      allow read: if isSignedIn() && (
        isPlatformAdmin() ||
        resource.data.authorUid == request.auth.uid ||
        isWorkspaceMember(resource.data.workspaceId)
      );
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && isValidId(messageId)
        && request.resource.data.body is string && request.resource.data.body.size() <= 5000
        && (isPlatformAdmin()
            ? request.resource.data.authorRole == 'admin'
            : (isWorkspaceMember(request.resource.data.workspaceId)
               && request.resource.data.authorRole == 'user'))
        && affectedKeys(['id', 'ticketId', 'workspaceId', 'authorUid', 'authorRole', 'body', 'createdAt']);
      allow update, delete: if false;
    }

    // Standard rule for remaining secondary metrics and details matching the blueprint
    match /{collectionName}/{documentId} {
      allow read: if isSignedIn() && !isProtectedCollection(collectionName) && (resource == null || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && !isProtectedCollection(collectionName) && request.resource.data.uid == request.auth.uid && isWorkspaceMember(request.resource.data.workspaceId) && isValidId(documentId) &&
        request.resource.data.keys().size() < 60; // Denial of Wallet payload protection for fallbacks
      allow update: if isSignedIn() && !isProtectedCollection(collectionName) && request.resource.data.uid == request.auth.uid && isWorkspaceMember(request.resource.data.workspaceId) && isUnchanged("workspaceId") && isUnchanged("uid") &&
        request.resource.data.keys().size() < 60; // Denial of Wallet payload protection for fallbacks
      allow delete: if false; // Prohibit destructive wildcard fallback deletes for unmodelled collections
    }
  }
}
